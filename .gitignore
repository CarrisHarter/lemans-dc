# Game data never enters version control: the port is never published under the
# Atari grant, and every binary here belongs to the rights holders.
# CarrisHarter/lemans-dc is a private backup of this repository and must stay
# private; scripts/git-hooks/pre-push refuses any push to a non-private repo.
analysis/*.bin
analysis/data/
analysis/export/
work/
rust/*/target/
__pycache__/
*.pyc

# Never commit the game image or a padded copy of it: the grant covers
# analysis, not redistribution.
fixtures/lemans24*.bin
