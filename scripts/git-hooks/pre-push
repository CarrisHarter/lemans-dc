#!/usr/bin/env bash
# Refuse any push that would put the ROM or extracted assets on a remote, or
# that targets a repository that is not private.
#
# The Atari SA grant covers static analysis and notes only: the port itself is
# never published, and CarrisHarter/lemans-dc is a private backup that must stay
# private. This hook is the last line of defence — it runs even for a manual push
# and blocks the whole push if either check fails.
set -uo pipefail

REPO="CarrisHarter/lemans-dc"
FORBIDDEN='^(analysis/.*\.bin|analysis/(data|export)/|work/|fixtures/lemans24.*\.bin)'

fail() { echo "pre-push: $*" >&2; exit 1; }

# 1. Private only.
private="$(gh api "repos/$REPO" --jq '.private' 2>/dev/null)"
[ "$private" = "true" ] || fail "$REPO is not confirmed private (got '${private:-no answer}'); refusing to push"

# 2. No forbidden path may be added by any pushed commit. Read the refs the
#    remote asked about on stdin (`<local ref> <local sha> <remote ref> <sha>`)
#    and diff each new range against the objects already on the remote.
checked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "${local_sha:-0}" = "0000000000000000000000000000000000000000" ] && continue
  if [ "${remote_sha:-0}" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
    added="$(git ls-tree -r --name-only "$local_sha")"
  else
    range="$remote_sha..$local_sha"
    added="$(git diff --name-only "$range" 2>/dev/null)"
  fi
  hit="$(printf '%s\n' "$added" | grep -E "$FORBIDDEN" || true)"
  if [ -n "$hit" ]; then
    printf '%s\n' "$hit" >&2
    fail "a pushed commit adds forbidden path(s) above (ROM/disc/extracted assets)"
  fi
  checked=$((checked + 1))
done

[ "$checked" -gt 0 ] || fail "no refs to check on stdin"
exit 0
